# 复制本文件为 .env（或运行 agent setup --write），只填你要用的那几项。
# .env 已在 .gitignore 里，不会被提交。真实密钥只写在 .env，不要写进任何会提交的文件。
#
# 写法注意：
#   - 每行 KEY=值；不要在值后面加注释（# 后面的内容会被当成值的一部分）
#   - 进程里已有的同名环境变量优先，.env 不会覆盖它
#   - 用不到的项保持注释状态

# ---------- 网络：国内访问部分外部 API 需要代理（端口换成你自己的）----------
# 不配时会尝试借用 Claude Code 设置（~/.claude/settings.json 的 env 段）里的代理
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1,::1

# ---------- 必填：主 Agent 文本模型（Kimi Code，key 形如 sk-kimi-...）----------
# 注意 Kimi Code 和 platform.moonshot.cn 是两条产品线，key 不通用，见 config/models.yaml 顶部
KIMI_API_KEY=

# ---------- 短剧 / 短视频必填：APIMart 聚合网关 ----------
# 生图、生视频、语音转写，以及短剧拆解与写剧本用的 gemini 都走它
APIMART_API_KEY=

# ---------- 短视频配音：MiniMax 中文 TTS（config/media_models.yaml 里 tts_provider: minimax）----------
# 没有 MiniMax 时可以把 tts_provider 改成 apimart（中文口播会偏「假」）；短剧不需要，声音由视频模型原生生成
# MINIMAX_API_KEY=
# 新式 sk-api- 开头的 key 不需要 GroupId，保留下面这行空值即可（删掉的话会把字面量 ${MINIMAX_GROUP_ID} 发出去）
MINIMAX_GROUP_ID=

# ---------- 本地图片当参考图：素材托管（config/hosting.yaml，默认 imghost + S.EE 图床）----------
# 生成接口只收公网链接，本地照片要先传到图床或对象存储
# SEE_API_TOKEN=
# 改用 imgbb 图床时（hosting.yaml 里 preset: imgbb）
# IMGBB_API_KEY=
# 改用对象存储时（hosting.yaml 里 type: s3）：阿里云 OSS / 腾讯云 COS / Cloudflare R2 / MinIO 的 AccessKey
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# ---------- 抖音热榜与爆款拆解：TikHub（可选；没有时热榜降级，拆解只能处理本地视频）----------
# TIKHUB_API_KEY=
# 没有 TikHub 时的回退：你自己导出的抖音 cookies.txt 路径（还要 pip install yt-dlp）
# DY_COOKIES=

# ---------- 可商用素材站：抖音 / 广告线联网找素材（免费申请，配一个就够）----------
# 申请地址 https://www.pexels.com/api/
# PEXELS_API_KEY=
# 申请地址 https://pixabay.com/api/docs/
# PIXABAY_API_KEY=

# ---------- 其他可选 ----------
# 运行时目录（默认是项目根下的 workspace/）
# AIGC_WORKSPACE=
# 海报叠字用的中文字体文件路径（macOS / Linux 找不到中文字体时用）
# AIGC_POSTER_FONT=

# ---------- MCP Server 密钥：见 config/mcp_servers.yaml 里的接入模板 ----------
# MATERIAL_LIB_KEY=
# PLATFORM_TOKEN=
