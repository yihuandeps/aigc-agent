# 复制本文件为 .env 并填入真实值。.env 已在 .gitignore 中，不会被提交。

# ---------- 网络：外部 API 多数要走代理才通 ----------
HTTPS_PROXY=http://127.0.0.1:PORT
HTTP_PROXY=http://127.0.0.1:PORT
NO_PROXY=localhost,127.0.0.1,::1

# ---------- 抖音素材抓取（可选，没有则只能处理本地视频）----------
# TIKHUB_API_KEY=

# ---------- Chat：主 Agent（Kimi / Moonshot）----------
KIMI_API_KEY=sk-kimi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------- 图像 / 视频（APIMart 聚合网关）----------
APIMART_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------- TTS：待定 ----------
# TTS_API_KEY=

# ---------- 本地素材托管（config/hosting.yaml type: s3 时用）----------
# S3_ACCESS_KEY=       # 阿里云 OSS / 腾讯云 COS / Cloudflare R2 的 AccessKey
# S3_SECRET_KEY=

# ---------- 可商用素材站（抖音分支联网找素材用，两家都免费申请）----------
# PEXELS_API_KEY=      # https://www.pexels.com/api/
# PIXABAY_API_KEY=     # https://pixabay.com/api/docs/

# ---------- MCP Server 密钥：见 config/mcp_servers.yaml ----------
# MATERIAL_LIB_KEY=
# PLATFORM_TOKEN=
