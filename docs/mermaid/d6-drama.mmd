    W4 --> W5["⑤ 渲参考图<br/>主形象 → 各场景服装 → 场景道具"]
    W5 --> W6["⑥ 渲分镜视频<br/>带参考图 · 前序片段 · 音色锚点"]
    W6 --> W7["拼接成片：配音 + 字幕"]
    W7 --> W8["看片复核"]
    W1 -. "字数或开场不合规格<br/>带问题扩写一次" .-> W1
    W6 -. "失败的段重跑时复用已成功的" .-> W6
