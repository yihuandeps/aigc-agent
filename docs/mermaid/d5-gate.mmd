flowchart TB
    M["模型要调一个工具"] --> K{"这个工具认识吗"}
    K -- "不认识" --> REJ["拒绝，并给出相近的工具名"]
    K -- "认识" --> LV{"看权限等级"}
    LV -- "只读" --> PASS["放行"]
    LV -- "改本地状态，可回滚" --> PASS
    LV -- "要花钱" --> COST{"预算够吗"}
    LV -- "不可逆的对外动作" --> HUM["强制问人，永不自动放行"]
    COST -- "够" --> PASS
    COST -- "不够" --> ASK["问人要不要追加金额"]
    HUM --> PASS
    ASK --> PASS
    PASS --> RUN["并发执行，按工具各自设超时"]
    RUN --> CUT["结果过长按工具上限截断"]
    CUT --> BACK["回填给模型"]
