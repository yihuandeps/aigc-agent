flowchart TB
    IN["用户输入"] --> R1["召回相关记忆（不调模型）"]
    R1 --> R2["把项目卡与记忆简报钉在注意力最强的位置"]
    R2 --> ASM["组装上下文"]
    ASM --> FIT{"装得下吗"}
    FIT -- "装不下" --> EV["驱逐最旧轮次<br/>仍不够就整轮压缩"]
    EV --> ASM
    FIT -- "装得下" --> CALL["调模型"]
    CALL --> ERR{"出错了吗"}
    ERR -- "网络断了" --> RT["网关重试<br/>连接类更深预算 + 退避抖动"]
    RT --> CALL
    ERR -- "超上下文" --> SK["压缩本轮后重试一次"]
    SK --> ASM
    ERR -- "正常" --> WANT{"要调工具吗"}
    WANT -- "不调" --> DONE["本轮完成"]
    WANT -- "要调" --> GATE["权限串行过闸 → 执行并发"]
    GATE --> SUSP{"有工具请人审吗"}
    SUSP -- "有" --> HOLD["挂起，等人拍板"]
    SUSP -- "没有" --> ASM
    HOLD --> RES["人的决策作为该工具的返回值填回"]
    RES --> ASM
